{
  "schema": "rozkalns.agent-bootstrap.v1",
  "repository": "rozkalnsandris/RPi5-maintenance",
  "shared_policy": {
    "work_cycle": "docs/WORK_CYCLE_V23_ADOPTION.md",
    "github_api_access": ".github/github-api-access-v1.json"
  },
  "rules": {
    "primary": "AGENTS.md",
    "local_strict_rules": [
      "AGENTS.md#production-trust-boundary-live-gate",
      "AGENTS.md#scheduled-automation"
    ]
  },
  "continuation": {
    "kind": "file",
    "locator": "HANDOFF.md"
  },
  "automation": {
    "fast_lane": true,
    "auto_run_full": false,
    "queue_mode": "not-applicable"
  },
  "deployment_profile": "custom"
}
