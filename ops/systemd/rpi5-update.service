[Unit]
Description=RPi5 weekly maintenance
Documentation=https://github.com/rozkalnsandris/RPi5-maintenance
Wants=network-online.target
After=network-online.target docker.service
OnSuccess=rpi5-maintenance-notify@success-%N.service
OnFailure=rpi5-maintenance-notify@failure-%N.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rpi5-update
TimeoutStartSec=2h
UMask=0077
Nice=10
