[Unit]
Description=RPi5 daily health monitor
Documentation=https://github.com/rozkalnsandris/RPi5-maintenance
Wants=network-online.target
After=network-online.target docker.service cloudflared.service ssh.service
OnFailure=rpi5-maintenance-notify@failure-%N.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rpi5-monitor
TimeoutStartSec=2min
UMask=0077
