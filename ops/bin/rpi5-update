#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export LC_ALL=C
export LANG=C
export COMPOSE_ANSI=never

readonly CONFIG_FILE='/etc/rpi-update.conf'
readonly LOCK_FILE='/run/lock/rpi5-maintenance-exclusive.lock'

MODE='run'
case "${1:-}" in
    '') ;;
    --check) MODE='check' ;;
    -h|--help)
        printf '%s\n' 'usage: rpi5-update [--check]'
        exit 0
        ;;
    *)
        printf 'unknown argument: %s\n' "$1" >&2
        exit 2
        ;;
esac
[[ $# -le 1 ]] || { echo 'too many arguments' >&2; exit 2; }

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
fail() { log "FAIL: $*" >&2; exit 1; }

phase='preflight'
on_error() {
    local rc=$?
    trap - ERR
    log "FAIL phase=${phase} rc=${rc}"
    exit "$rc"
}
trap on_error ERR

# APT may restart dockerd and the AdGuard-backed host DNS resolver.
# Wait for two consecutive successful checks before any image pull.
wait_for_post_apt_docker_dns() {
    local check consecutive=0
    log 'Waiting for Docker and registry DNS after APT upgrade'
    for ((check=1; check<=12; check++)); do
        if timeout 5 docker info >/dev/null 2>&1 &&
           timeout 5 getent ahostsv4 auth.docker.io >/dev/null 2>&1; then
            consecutive=$((consecutive + 1))
            if (( consecutive >= 2 )); then
                log 'Docker and registry DNS ready'
                return 0
            fi
        else
            consecutive=0
        fi
        if (( check < 12 )); then
            sleep 5
        fi
    done
    fail 'phase=docker-ready Docker or registry DNS not stable after APT upgrade (12 checks)'
}

[[ ${EUID:-$(id -u)} -eq 0 ]] || fail 'run as root'

if [[ -e "$CONFIG_FILE" ]]; then
    [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || fail "unsafe config: $CONFIG_FILE"
    [[ "$(stat -c '%u' "$CONFIG_FILE")" == '0' ]] || fail "config must be root-owned: $CONFIG_FILE"
    config_mode="$(stat -c '%a' "$CONFIG_FILE")"
    (( (8#$config_mode & 022) == 0 )) || fail "config must not be group/world writable: $CONFIG_FILE"
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

MAIN_COMPOSE_DIR="${MAIN_COMPOSE_DIR:-/home/andris/docker}"
CLEANUP_RETENTION_DAYS="${CLEANUP_RETENTION_DAYS:-14}"
BUILD_CACHE_MAX="${BUILD_CACHE_MAX:-8gb}"
REBOOT_POLICY="${REBOOT_POLICY:-if-needed}"
MONITOR_BIN="${MONITOR_BIN:-/usr/local/sbin/rpi5-monitor}"

[[ "$MAIN_COMPOSE_DIR" == /* && -d "$MAIN_COMPOSE_DIR" ]] || fail 'MAIN_COMPOSE_DIR must be an existing absolute directory'
[[ "$CLEANUP_RETENTION_DAYS" =~ ^[0-9]+$ ]] || fail 'CLEANUP_RETENTION_DAYS must be an integer'
(( CLEANUP_RETENTION_DAYS >= 1 && CLEANUP_RETENTION_DAYS <= 3650 )) || fail 'CLEANUP_RETENTION_DAYS outside 1..3650'
[[ "$BUILD_CACHE_MAX" =~ ^[0-9]+([kmgt]i?b)?$ ]] || fail 'BUILD_CACHE_MAX must be a Docker byte value such as 8gb'
case "$REBOOT_POLICY" in if-needed|never) ;; *) fail 'REBOOT_POLICY must be if-needed or never' ;; esac
[[ -x "$MONITOR_BIN" ]] || fail "monitor missing or not executable: $MONITOR_BIN"

for command_name in apt-get docker flock getent journalctl sleep systemctl systemd-tmpfiles timeout; do
    command -v "$command_name" >/dev/null 2>&1 || fail "missing command: $command_name"
done

started_at="$(date +%s)"

# Snapshots of main Compose container image IDs only; no other app health.
compose_images_snapshot() (
    cd "$MAIN_COMPOSE_DIR"
    docker compose images --format json | python3 -c '
import json, re, sys
for image in json.load(sys.stdin):
    name = str(image.get("Repository", "")) + ":" + str(image.get("Tag", ""))
    image_id = str(image.get("ID", ""))
    if re.fullmatch(r"[A-Za-z0-9._/@:-]{1,160}", name) and re.fullmatch(r"sha256:[0-9a-f]{64}", image_id):
        print(name + "\t" + image_id[7:19])
'
)

# Root writes a sanitized report bound to the exact systemd invocation.
# The credential-isolated notifier reads only this allowlisted information.
write_weekly_report() {
    local invocation="${INVOCATION_ID:-}" dir='/run/rpi5-maintenance-reports'
    local apt_count reclaimed duration time_text reboot_state tmp image_name image_id old_id changes=0
    local -A before=()
    [[ "$invocation" =~ ^[0-9a-f]{32}$ ]] || fail 'missing systemd invocation for weekly report'
    apt_count="$(journalctl "_SYSTEMD_INVOCATION_ID=$invocation" --no-pager -o cat |
        sed -nE 's/^([0-9]+ upgraded, [0-9]+ newly installed, [0-9]+ to remove and [0-9]+ not upgraded)\.$/\1/p' | tail -n 1)"
    reclaimed="$(journalctl "_SYSTEMD_INVOCATION_ID=$invocation" --no-pager -o cat |
        sed -nE 's/^Total reclaimed space: ([0-9]+(\.[0-9]+)?[A-Za-z]+)$/\1/p' | tail -n 2 | paste -sd '+' -)"
    [[ -n "$apt_count" ]] || apt_count='pabeigts (pakotņu skaits nav pieejams)'
    [[ -n "$reclaimed" ]] || reclaimed='apjoms nav pieejams'
    duration=$(( $(date +%s) - started_at ))
    printf -v time_text '%02d:%02d:%02d' "$((duration / 3600))" "$(((duration / 60) % 60))" "$((duration % 60))"
    reboot_state='NAV vajadzīgs'
    if [[ -e /run/reboot-required ]]; then
        if [[ "$REBOOT_POLICY" == if-needed ]]; then
            reboot_state='PIEPRASĪTS (pēcreboot pārbaude nav veikta)'
        else
            reboot_state='VAJADZĪGS (politika: never)'
        fi
    fi
    install -d -o root -g root -m 0755 "$dir"
    tmp="$(mktemp "$dir/.report.XXXXXXXX")"
    {
        printf '%s\n\n' '✅ RPi5 SVĒTDIENAS UPDATE VEIKSMĪGS'
        printf '🧹 Tīrīšana (%sd): ✅ (Docker: %s)\n' "$CLEANUP_RETENTION_DAYS" "$reclaimed"
        printf '📦 APT: %s ✅\n' "$apt_count"
        printf '%s\n' '🐳 Docker main: ✅' '🩺 RPi5 lokālais monitors: ✅'
        printf '⏱ Ilgums: %s\n' "$time_text"
        printf '🔁 Reboot: %s\n\n' "$reboot_state"
        while IFS=
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose config --quiet
)

if [[ "$MODE" == 'check' ]]; then
    phase='apt-check'
    apt-get -s upgrade --with-new-pkgs --no-remove >/dev/null
    phase='monitor'
    "$MONITOR_BIN"
    log 'CHECK PASS'
    exit 0
fi

if [[ -e "$LOCK_FILE" || -L "$LOCK_FILE" ]]; then
    [[ -f "$LOCK_FILE" && ! -L "$LOCK_FILE" && "$(stat -c '%u' "$LOCK_FILE")" == '0' ]] ||
        fail "unsafe shared lock: $LOCK_FILE"
else
    install -o root -g root -m 0600 /dev/null "$LOCK_FILE"
fi
exec 9<>"$LOCK_FILE"
if ! flock -n 9; then
    log 'SKIP: another maintenance/backup operation holds the shared lock'
    exit 75
fi

log 'RPi5 weekly maintenance started'

phase='docker-snapshot-before'
images_before_snapshot="$(compose_images_snapshot)"

# Queue a start notice through the credential-isolated systemd notifier.
if [[ "${INVOCATION_ID:-}" =~ ^[0-9a-f]{32}$ ]]; then
    systemctl --no-block start rpi5-maintenance-notify@start-rpi5-update.service.service ||
        log 'WARN: start notification not queued'
fi

phase='apt'
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --with-new-pkgs --no-remove
apt-get check

phase='docker-ready'
wait_for_post_apt_docker_dns

phase='docker-pull'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose pull --ignore-buildable
)

phase='docker-up'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose up -d --no-build --wait --wait-timeout 180
)

phase='docker-snapshot-after'
images_after_snapshot="$(compose_images_snapshot)"

phase='cleanup'
retention_hours=$((CLEANUP_RETENTION_DAYS * 24))
apt-get autoclean -y
journalctl --vacuum-time="${CLEANUP_RETENTION_DAYS}d"
systemd-tmpfiles --clean
docker image prune -f --filter "until=${retention_hours}h"
docker buildx prune -f --filter "until=${retention_hours}h" --max-used-space "$BUILD_CACHE_MAX"

phase='monitor'
"$MONITOR_BIN"

phase='report'
write_weekly_report

phase='reboot'
if [[ -e /run/reboot-required ]]; then
    if [[ "$REBOOT_POLICY" == 'if-needed' ]]; then
        log 'Maintenance PASS; reboot required, rebooting now'
        systemctl reboot
    else
        log 'Maintenance PASS; reboot required but REBOOT_POLICY=never'
    fi
else
    log 'Maintenance PASS; reboot not required'
fi
\t' read -r image_name image_id; do
            [[ -n "$image_name" ]] && before["$image_name"]="$image_id"
        done <<<"$images_before_snapshot"
        while IFS=
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose config --quiet
)

if [[ "$MODE" == 'check' ]]; then
    phase='apt-check'
    apt-get -s upgrade --with-new-pkgs --no-remove >/dev/null
    phase='monitor'
    "$MONITOR_BIN"
    log 'CHECK PASS'
    exit 0
fi

if [[ -e "$LOCK_FILE" || -L "$LOCK_FILE" ]]; then
    [[ -f "$LOCK_FILE" && ! -L "$LOCK_FILE" && "$(stat -c '%u' "$LOCK_FILE")" == '0' ]] ||
        fail "unsafe shared lock: $LOCK_FILE"
else
    install -o root -g root -m 0600 /dev/null "$LOCK_FILE"
fi
exec 9<>"$LOCK_FILE"
if ! flock -n 9; then
    log 'SKIP: another maintenance/backup operation holds the shared lock'
    exit 75
fi

log 'RPi5 weekly maintenance started'

phase='apt'
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --with-new-pkgs --no-remove
apt-get check

phase='docker-ready'
wait_for_post_apt_docker_dns

phase='docker-pull'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose pull --ignore-buildable
)

phase='docker-up'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose up -d --no-build --wait --wait-timeout 180
)

phase='cleanup'
retention_hours=$((CLEANUP_RETENTION_DAYS * 24))
apt-get autoclean -y
journalctl --vacuum-time="${CLEANUP_RETENTION_DAYS}d"
systemd-tmpfiles --clean
docker image prune -f --filter "until=${retention_hours}h"
docker buildx prune -f --filter "until=${retention_hours}h" --max-used-space "$BUILD_CACHE_MAX"

phase='monitor'
"$MONITOR_BIN"

phase='reboot'
if [[ -e /run/reboot-required ]]; then
    if [[ "$REBOOT_POLICY" == 'if-needed' ]]; then
        log 'Maintenance PASS; reboot required, rebooting now'
        systemctl reboot
    else
        log 'Maintenance PASS; reboot required but REBOOT_POLICY=never'
    fi
else
    log 'Maintenance PASS; reboot not required'
fi
\t' read -r image_name image_id; do
            [[ -n "$image_name" && -n "$image_id" ]] || continue
            old_id="${before[$image_name]:-}"
            if [[ -n "$old_id" && "$old_id" != "$image_id" ]]; then
                if (( changes == 0 )); then printf '%s\n' 'Atjauninātie main Docker image:'; fi
                if (( changes < 8 )); then printf '• %s: %s → %s\n' "$image_name" "$old_id" "$image_id"; fi
                changes=$((changes + 1))
            fi
        done <<<"$images_after_snapshot"
        if (( changes == 0 )); then
            printf '%s\n' 'Docker image: ID izmaiņas nav konstatētas'
        elif (( changes > 8 )); then
            printf '... un vēl %d image\n' "$((changes - 8))"
        fi
        printf '\nLogs: journalctl -u rpi5-update.service\n'
    } >"$tmp"
    chmod 0644 "$tmp"
    mv -f -- "$tmp" "$dir/$invocation.txt"
    log 'Sanitized weekly Telegram report ready'
}

phase='preflight'
docker info >/dev/null
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose config --quiet
)

if [[ "$MODE" == 'check' ]]; then
    phase='apt-check'
    apt-get -s upgrade --with-new-pkgs --no-remove >/dev/null
    phase='monitor'
    "$MONITOR_BIN"
    log 'CHECK PASS'
    exit 0
fi

if [[ -e "$LOCK_FILE" || -L "$LOCK_FILE" ]]; then
    [[ -f "$LOCK_FILE" && ! -L "$LOCK_FILE" && "$(stat -c '%u' "$LOCK_FILE")" == '0' ]] ||
        fail "unsafe shared lock: $LOCK_FILE"
else
    install -o root -g root -m 0600 /dev/null "$LOCK_FILE"
fi
exec 9<>"$LOCK_FILE"
if ! flock -n 9; then
    log 'SKIP: another maintenance/backup operation holds the shared lock'
    exit 75
fi

log 'RPi5 weekly maintenance started'

phase='apt'
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --with-new-pkgs --no-remove
apt-get check

phase='docker-ready'
wait_for_post_apt_docker_dns

phase='docker-pull'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose pull --ignore-buildable
)

phase='docker-up'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose up -d --no-build --wait --wait-timeout 180
)

phase='cleanup'
retention_hours=$((CLEANUP_RETENTION_DAYS * 24))
apt-get autoclean -y
journalctl --vacuum-time="${CLEANUP_RETENTION_DAYS}d"
systemd-tmpfiles --clean
docker image prune -f --filter "until=${retention_hours}h"
docker buildx prune -f --filter "until=${retention_hours}h" --max-used-space "$BUILD_CACHE_MAX"

phase='monitor'
"$MONITOR_BIN"

phase='reboot'
if [[ -e /run/reboot-required ]]; then
    if [[ "$REBOOT_POLICY" == 'if-needed' ]]; then
        log 'Maintenance PASS; reboot required, rebooting now'
        systemctl reboot
    else
        log 'Maintenance PASS; reboot required but REBOOT_POLICY=never'
    fi
else
    log 'Maintenance PASS; reboot not required'
fi
