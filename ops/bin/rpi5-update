#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export LC_ALL=C
export LANG=C
export COMPOSE_ANSI=never

readonly CONFIG_FILE='/etc/rpi-update.conf'
readonly LOCK_FILE='/run/lock/rpi5-maintenance-exclusive.lock'

MODE='run'
case "${1:-}" in
    '') ;;
    --check) MODE='check' ;;
    -h|--help)
        printf '%s\n' 'usage: rpi5-update [--check]'
        exit 0
        ;;
    *)
        printf 'unknown argument: %s\n' "$1" >&2
        exit 2
        ;;
esac
[[ $# -le 1 ]] || { echo 'too many arguments' >&2; exit 2; }

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
fail() { log "FAIL: $*" >&2; exit 1; }

phase='preflight'
on_error() {
    local rc=$?
    trap - ERR
    log "FAIL phase=${phase} rc=${rc}"
    exit "$rc"
}
trap on_error ERR

[[ ${EUID:-$(id -u)} -eq 0 ]] || fail 'run as root'

if [[ -e "$CONFIG_FILE" ]]; then
    [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || fail "unsafe config: $CONFIG_FILE"
    [[ "$(stat -c '%u' "$CONFIG_FILE")" == '0' ]] || fail "config must be root-owned: $CONFIG_FILE"
    config_mode="$(stat -c '%a' "$CONFIG_FILE")"
    (( (8#$config_mode & 022) == 0 )) || fail "config must not be group/world writable: $CONFIG_FILE"
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

MAIN_COMPOSE_DIR="${MAIN_COMPOSE_DIR:-/home/andris/docker}"
CLEANUP_RETENTION_DAYS="${CLEANUP_RETENTION_DAYS:-14}"
BUILD_CACHE_MAX="${BUILD_CACHE_MAX:-8gb}"
REBOOT_POLICY="${REBOOT_POLICY:-if-needed}"
MONITOR_BIN="${MONITOR_BIN:-/usr/local/sbin/rpi5-monitor}"

[[ "$MAIN_COMPOSE_DIR" == /* && -d "$MAIN_COMPOSE_DIR" ]] || fail 'MAIN_COMPOSE_DIR must be an existing absolute directory'
[[ "$CLEANUP_RETENTION_DAYS" =~ ^[0-9]+$ ]] || fail 'CLEANUP_RETENTION_DAYS must be an integer'
(( CLEANUP_RETENTION_DAYS >= 1 && CLEANUP_RETENTION_DAYS <= 3650 )) || fail 'CLEANUP_RETENTION_DAYS outside 1..3650'
[[ "$BUILD_CACHE_MAX" =~ ^[0-9]+([kmgt]i?b)?$ ]] || fail 'BUILD_CACHE_MAX must be a Docker byte value such as 8gb'
case "$REBOOT_POLICY" in if-needed|never) ;; *) fail 'REBOOT_POLICY must be if-needed or never' ;; esac
[[ -x "$MONITOR_BIN" ]] || fail "monitor missing or not executable: $MONITOR_BIN"

for command_name in apt-get docker flock journalctl systemctl systemd-tmpfiles; do
    command -v "$command_name" >/dev/null 2>&1 || fail "missing command: $command_name"
done

phase='preflight'
docker info >/dev/null
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose config --quiet
)

if [[ "$MODE" == 'check' ]]; then
    phase='apt-check'
    apt-get -s upgrade --with-new-pkgs --no-remove >/dev/null
    phase='monitor'
    "$MONITOR_BIN"
    log 'CHECK PASS'
    exit 0
fi

touch "$LOCK_FILE"
chmod 0600 "$LOCK_FILE"
exec 9<>"$LOCK_FILE"
if ! flock -n 9; then
    log 'SKIP: another maintenance/backup operation holds the shared lock'
    exit 75
fi

log 'RPi5 weekly maintenance started'

phase='apt'
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --with-new-pkgs --no-remove
apt-get check

phase='docker-pull'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose pull --ignore-buildable
)

phase='docker-up'
(
    cd "$MAIN_COMPOSE_DIR"
    docker compose up -d --no-build --wait --wait-timeout 180
)

phase='cleanup'
retention_hours=$((CLEANUP_RETENTION_DAYS * 24))
apt-get autoclean -y
journalctl --vacuum-time="${CLEANUP_RETENTION_DAYS}d"
systemd-tmpfiles --clean
docker image prune -f --filter "until=${retention_hours}h"
docker buildx prune -f --filter "until=${retention_hours}h" --max-used-space "$BUILD_CACHE_MAX"

phase='monitor'
"$MONITOR_BIN"

phase='reboot'
if [[ -e /run/reboot-required ]]; then
    if [[ "$REBOOT_POLICY" == 'if-needed' ]]; then
        log 'Maintenance PASS; reboot required, rebooting now'
        systemctl reboot
    else
        log 'Maintenance PASS; reboot required but REBOOT_POLICY=never'
    fi
else
    log 'Maintenance PASS; reboot not required'
fi
