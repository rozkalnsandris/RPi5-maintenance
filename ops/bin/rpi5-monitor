#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export LC_ALL=C
export LANG=C
export COMPOSE_ANSI=never

MAIN_COMPOSE_DIR="${MAIN_COMPOSE_DIR:-/home/andris/docker}"
DISK_FAIL_PERCENT="${DISK_FAIL_PERCENT:-90}"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
fail() { log "FAIL: $*" >&2; exit 1; }

[[ "$MAIN_COMPOSE_DIR" == /* && -d "$MAIN_COMPOSE_DIR" ]] || fail 'MAIN_COMPOSE_DIR must be an existing absolute directory'
[[ "$DISK_FAIL_PERCENT" =~ ^[0-9]+$ ]] || fail 'DISK_FAIL_PERCENT must be an integer'
(( DISK_FAIL_PERCENT >= 1 && DISK_FAIL_PERCENT <= 100 )) || fail 'DISK_FAIL_PERCENT outside 1..100'

for command_name in docker systemctl df sort; do
    command -v "$command_name" >/dev/null 2>&1 || fail "missing command: $command_name"
done

log 'RPi5 monitor started'

for unit in docker.service ssh.service cloudflared.service; do
    systemctl is-active --quiet "$unit" || fail "$unit is not active"
done

docker info >/dev/null || fail 'Docker daemon is unavailable'

expected_text="$(
    cd "$MAIN_COMPOSE_DIR"
    docker compose config --quiet
    docker compose config --services | sort -u
)" || fail 'cannot read main Compose services'
[[ -n "$expected_text" ]] || fail 'main Compose project has no services'
mapfile -t expected_services <<<"$expected_text"

running_text="$(
    cd "$MAIN_COMPOSE_DIR"
    docker compose ps --services --status running | sort -u
)" || fail 'cannot read running main Compose services'
running_services=()
if [[ -n "$running_text" ]]; then
    mapfile -t running_services <<<"$running_text"
fi

declare -A running=()
for service in "${running_services[@]}"; do running["$service"]=1; done
missing=()
for service in "${expected_services[@]}"; do
    [[ -n "${running[$service]:-}" ]] || missing+=("$service")
done
(( ${#missing[@]} == 0 )) || fail "main Compose services not running: ${missing[*]}"

unhealthy_text="$(docker ps --filter health=unhealthy --format '{{.Names}}' | sort -u)" ||
    fail 'cannot inspect unhealthy containers'
[[ -z "$unhealthy_text" ]] || fail "unhealthy containers: $unhealthy_text"

restarting_text="$(docker ps --filter status=restarting --format '{{.Names}}' | sort -u)" ||
    fail 'cannot inspect restarting containers'
[[ -z "$restarting_text" ]] || fail "restarting containers: $restarting_text"

root_use="$(df -P / | awk 'NR==2 {gsub(/%/, "", $5); print $5}')"
[[ "$root_use" =~ ^[0-9]+$ ]] || fail 'cannot read root filesystem usage'
(( root_use < DISK_FAIL_PERCENT )) || fail "root filesystem usage is ${root_use}% (limit ${DISK_FAIL_PERCENT}%)"

if [[ -e /run/reboot-required ]]; then
    log 'WARN reboot required'
fi

log "PASS services=${#expected_services[@]} root=${root_use}%"
