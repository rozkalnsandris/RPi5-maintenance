#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LC_ALL=C
export LANG=C

readonly TELEGRAM_HELPER="/usr/local/lib/rpi5-maintenance/rpi5-maintenance-telegram.py"
readonly FALLBACK_INSTANCE="${1:-unknown.service}"

case "$FALLBACK_INSTANCE" in
    start-*)
        fallback_unit="${FALLBACK_INSTANCE#start-}"
        fallback_result="start"
        ;;
    success-*)
        fallback_unit="${FALLBACK_INSTANCE#success-}"
        fallback_result="success"
        ;;
    failure-*)
        fallback_unit="${FALLBACK_INSTANCE#failure-}"
        fallback_result="failure"
        ;;
    *)
        fallback_unit="$FALLBACK_INSTANCE"
        fallback_result="unknown"
        ;;
esac

unit="${MONITOR_UNIT:-$fallback_unit}"
result="${MONITOR_SERVICE_RESULT:-$fallback_result}"
exit_code="${MONITOR_EXIT_CODE:-unknown}"
exit_status="${MONITOR_EXIT_STATUS:-unknown}"
invocation_id="${MONITOR_INVOCATION_ID:-unknown}"

case "$result" in
    start)
        icon="🔄"
        heading="RPi5 SVĒTDIENAS UPDATE SĀKTS"
        ;;
    success)
        icon="✅"
        heading="RPi5 MAINTENANCE SERVICE OK"
        ;;
    *)
        icon="❌"
        heading="RPi5 MAINTENANCE SERVICE FAILURE"
        ;;
esac

if [[ "$result" == 'start' && "$unit" == 'rpi5-update.service' ]]; then
    message="🔄 RPi5 SVĒTDIENAS UPDATE SĀKTS

Režīms: drošs automātiskais update
Laiks: $(date '+%Y-%m-%d %H:%M:%S %Z')"
else
    message="${icon} ${heading}

Unit: ${unit}
Result: ${result}
Exit: ${exit_code}/${exit_status}
Invocation: ${invocation_id}
Time: $(date '+%Y-%m-%d %H:%M:%S %Z')

Logs: journalctl -u ${unit}"
fi

# Accept only a current root-owned regular report for the exact source
# invocation, never an old or unrelated weekly message.
if [[ "$result" == 'success' && "$unit" == 'rpi5-update.service' &&
      "$invocation_id" =~ ^[0-9a-f]{32}$ ]]; then
    report="/run/rpi5-maintenance-reports/${invocation_id}.txt"
    if [[ -f "$report" && ! -L "$report" &&
          "$(stat -c '%u:%a' "$report")" == '0:644' ]]; then
        message="$(head -c 3500 -- "$report")"
        message+="
☁️ rclone: APT pārvaldīts; atsevišķi nav atjaunināts
🤖 Hermes: MANUAL (nav atjaunināts)
ℹ️ CV/publiskie servisi: ārpus šī monitora tvēruma"
    fi
fi

printf '%s\n' "$message" | python3 "$TELEGRAM_HELPER"
