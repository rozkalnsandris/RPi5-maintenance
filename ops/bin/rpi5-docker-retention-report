#!/usr/bin/env python3
from __future__ import annotations
import argparse, datetime as dt, importlib.util, json, os, re, subprocess, sys
from pathlib import Path
from typing import Any

RUN_ID_RE=re.compile(r'^[0-9]{8}_[0-9]{6}$')
IMAGE_ID_RE=re.compile(r'^sha256:[0-9a-f]{64}$')
PROJECT_RE=re.compile(r'^[A-Za-z0-9._:-]+$')
HEX64_RE=re.compile(r'^[0-9a-f]{64}$')
SIZE_RE=re.compile(r'^([0-9]+(?:\.[0-9]+)?)([kKmMgGtTpP]?[iI]?[bB])$')
READONLY_PREFIXES=(
 ('docker','ps'),('docker','inspect'),('docker','image','ls'),('docker','image','inspect'),
 ('docker','compose','config'),('docker','compose','ps'),('docker','volume','ls'),
 ('docker','volume','inspect'),('docker','system','df'),('df','-P','/'),
)

class ReportError(RuntimeError): pass

class Runner:
    def __init__(self, timeout_seconds:int): self.timeout_seconds=timeout_seconds
    def run(self, argv:list[str], *, cwd:Path|None=None)->str:
        if not any(tuple(argv[:len(p)])==p for p in READONLY_PREFIXES):
            raise ReportError(f'refusing non-read-only command: {argv!r}')
        try:
            cp=subprocess.run(argv,cwd=None if cwd is None else str(cwd),text=True,
                stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=False,timeout=self.timeout_seconds,
                env={**os.environ,'LC_ALL':'C','LANG':'C','COMPOSE_ANSI':'never'})
        except subprocess.TimeoutExpired as exc:
            raise ReportError(f'command timeout after {self.timeout_seconds}s: {argv!r}') from exc
        if cp.returncode!=0:
            err=cp.stderr.strip().replace('\n',' ')[:400]
            raise ReportError(f'read-only command failed rc={cp.returncode}: {argv!r}: {err}')
        return cp.stdout

def load_module(name:str,path:Path):
    spec=importlib.util.spec_from_file_location(name,path)
    if spec is None or spec.loader is None: raise ReportError(f'cannot load module: {path}')
    mod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod); return mod

def parse_json(text:str,ctx:str)->Any:
    try: return json.loads(text)
    except json.JSONDecodeError as exc: raise ReportError(f'invalid JSON from {ctx}: {exc}') from exc

def parse_array(text:str,ctx:str)->list[Any]:
    v=parse_json(text,ctx)
    if not isinstance(v,list): raise ReportError(f'{ctx} must return JSON array')
    return v

def image_id(v:Any,ctx:str)->str:
    if not isinstance(v,str) or not IMAGE_ID_RE.fullmatch(v): raise ReportError(f'invalid image id for {ctx}: {v!r}')
    return v

def repo_root(ref:str)->str:
    ref=ref.strip()
    if not ref or ref=='<none>:<none>': raise ReportError(f'invalid Docker reference: {ref!r}')
    if '@' in ref: return ref.split('@',1)[0]
    slash=ref.rfind('/'); colon=ref.rfind(':')
    return ref[:colon] if colon>slash else ref

def created_epoch(v:Any)->int:
    if not isinstance(v,str) or not v: raise ReportError(f'invalid Created timestamp: {v!r}')
    t=v.strip()
    if t.endswith('Z'): t=t[:-1]+'+00:00'
    m=re.match(r'^(.*?)(\.[0-9]+)([+-][0-9]{2}:[0-9]{2})$',t)
    if m: t=f"{m.group(1)}.{m.group(2)[1:][:6].ljust(6,'0')}{m.group(3)}"
    try: d=dt.datetime.fromisoformat(t)
    except ValueError as exc: raise ReportError(f'invalid Created timestamp: {v!r}') from exc
    if d.tzinfo is None: d=d.replace(tzinfo=dt.timezone.utc)
    return int(d.timestamp())

def parse_bytes(text:str)->int:
    token=text.strip().split()[0]; m=SIZE_RE.fullmatch(token)
    if not m: raise ReportError(f'cannot parse Docker size: {text!r}')
    n=float(m.group(1)); unit=m.group(2).lower()
    binary=unit.endswith('ib'); table={'b':0,'kb':1,'mb':2,'gb':3,'tb':4,'pb':5,'kib':1,'mib':2,'gib':3,'tib':4,'pib':5}
    if unit not in table: raise ReportError(f'unsupported Docker size unit: {unit}')
    return int(n*((1024 if binary else 1000)**table[unit]))

def image_repos(item:dict[str,Any])->list[str]:
    out=set()
    for key in ('RepoTags','RepoDigests'):
        vals=item.get(key) or []
        if not isinstance(vals,list): raise ReportError(f'{key} must be array')
        for ref in vals:
            if not isinstance(ref,str): raise ReportError(f'invalid {key} value')
            if ref!='<none>:<none>': out.add(repo_root(ref))
    return sorted(out)

def collect_containers(r:Runner):
    ids=[x for x in r.run(['docker','ps','-aq']).split() if x]
    if not ids: return [],{}
    rows=parse_array(r.run(['docker','inspect',*ids]),'docker inspect containers')
    out=[]; by_id={}; names=set()
    for row in rows:
        if not isinstance(row,dict): raise ReportError('container inspect entry must be object')
        cid=row.get('Id'); name=row.get('Name'); iid=image_id(row.get('Image'),f'container {cid}')
        if not isinstance(cid,str) or not cid: raise ReportError('container Id missing')
        if not isinstance(name,str) or not name.startswith('/') or len(name)<2: raise ReportError(f'invalid container name: {name!r}')
        clean=name[1:]
        if clean in names: raise ReportError(f'duplicate container name: {clean}')
        names.add(clean); out.append({'name':clean,'image_id':iid}); by_id[cid]=row
    return sorted(out,key=lambda x:x['name']),by_id

def collect_images(r:Runner):
    ids=sorted(set(x for x in r.run(['docker','image','ls','--no-trunc','--quiet']).split() if x))
    if not ids: return {}
    rows=parse_array(r.run(['docker','image','inspect',*ids]),'docker image inspect')
    out={}
    for row in rows:
        if not isinstance(row,dict): raise ReportError('image inspect entry must be object')
        iid=image_id(row.get('Id'),'image inspect'); size=row.get('Size')
        if not isinstance(size,int) or isinstance(size,bool) or size<0: raise ReportError(f'invalid image size: {iid}')
        out[iid]={'id':iid,'created_epoch':created_epoch(row.get('Created')),'size_bytes':size,'repositories':image_repos(row)}
    return out

def compose_config(r:Runner,path:Path)->dict[str,Any]:
    if not path.is_dir(): raise ReportError(f'Compose directory missing: {path}')
    v=parse_json(r.run(['docker','compose','config','--format','json'],cwd=path),f'compose config {path}')
    if not isinstance(v,dict) or not isinstance(v.get('services'),dict): raise ReportError(f'invalid Compose config: {path}')
    return v

def compose_container(r:Runner,path:Path,service:str)->str:
    ids=[x for x in r.run(['docker','compose','ps','-q',service],cwd=path).split() if x]
    if len(ids)!=1: raise ReportError(f'expected one running container for {path}:{service}, got {len(ids)}')
    return ids[0]

def local_image_id(r:Runner,ref:str)->str:
    rows=parse_array(r.run(['docker','image','inspect',ref]),f'image inspect {ref}')
    if len(rows)!=1 or not isinstance(rows[0],dict): raise ReportError(f'expected one local image for {ref}')
    return image_id(rows[0].get('Id'),f'candidate {ref}')

def collect_services(r:Runner,projects,containers_by_id,images):
    managed=[]; refs={}; seen=set()
    for project,path in projects:
        cfg=compose_config(r,path)
        for service in sorted(cfg['services']):
            spec=cfg['services'][service]
            if not isinstance(spec,dict): raise ReportError(f'invalid service {project}/{service}')
            if spec.get('build') is not None: continue
            ref=spec.get('image')
            if not isinstance(ref,str) or not ref: raise ReportError(f'registry service missing image: {project}/{service}')
            key=(project,service)
            if key in seen: raise ReportError(f'duplicate service: {project}/{service}')
            seen.add(key); cid=compose_container(r,path,service); c=containers_by_id.get(cid)
            if c is None: raise ReportError(f'Compose container absent from global inventory: {project}/{service}')
            current=image_id(c.get('Image'),f'current {project}/{service}'); candidate=local_image_id(r,ref)
            if current not in images or candidate not in images: raise ReportError(f'unknown image for {project}/{service}')
            lineage=repo_root(ref)
            for iid in (current,candidate): images[iid]['repositories']=sorted(set(images[iid]['repositories'])|{lineage})
            name=c.get('Name')
            if not isinstance(name,str) or not name.startswith('/'): raise ReportError(f'invalid current container name: {project}/{service}')
            managed.append({'project':project,'service':service,'lineage':lineage,'current_container':name[1:],'candidate_ids':[candidate]})
            refs[key]=ref
    return sorted(managed,key=lambda x:(x['project'],x['service'])),refs

def safe_file(p:Path)->bool:
    return p.is_file() and not p.is_symlink()

def successful_run(run_dir:Path,run_id:str,project:str)->bool:
    p=run_dir/'phases.jsonl'
    if not safe_file(p): return False
    reconcile=health=False
    try:
        lines=p.read_text(encoding='utf-8').splitlines()
    except OSError as exc: raise ReportError(f'cannot read {p}: {exc}') from exc
    for raw in lines:
        if not raw.strip(): continue
        e=parse_json(raw,str(p))
        if not isinstance(e,dict) or e.get('run_id')!=run_id: raise ReportError(f'invalid run_id in {p}')
        if e.get('project')!=project: continue
        if e.get('phase')=='reconcile' and e.get('command')=='compose-up' and e.get('outcome')=='succeeded' and e.get('rc')==0: reconcile=True
        if e.get('phase')=='final-health' and e.get('command')=='compose-runtime-check' and e.get('outcome')=='healthy' and e.get('rc')==0: health=True
    return reconcile and health

def before_snapshot(run_dir:Path,project:str)->dict[str,str]:
    p=run_dir/f'docker-{project}-images-before.tsv'
    if not safe_file(p): return {}
    out={}
    try: lines=p.read_text(encoding='utf-8').splitlines()
    except OSError as exc: raise ReportError(f'cannot read {p}: {exc}') from exc
    for n,line in enumerate(lines,1):
        if not line: continue
        parts=line.split('\t')
        if len(parts)!=3: raise ReportError(f'malformed snapshot {p}:{n}')
        ref,iid,_=parts
        if ref in out: raise ReportError(f'duplicate ref in {p}: {ref}')
        if iid!='MISSING': out[ref]=image_id(iid,f'{p}:{n}')
    return out

def collect_rollback(root:Path,run_ids,managed,refs,images,containers_by_name):
    for rid in run_ids:
        if not RUN_ID_RE.fullmatch(rid): raise ReportError(f'invalid trusted run id: {rid!r}')
    if root.is_symlink() or not root.is_dir(): raise ReportError(f'evidence root missing/unsafe: {root}')
    out=[]; success={}; snaps={}
    for svc in managed:
        project,name=svc['project'],svc['service']; current=containers_by_name[svc['current_container']]; ref=refs[(project,name)]; lineage=svc['lineage']
        chosen=None
        for rid in sorted(set(run_ids),reverse=True):
            d=root/rid
            if d.is_symlink() or not d.is_dir(): raise ReportError(f'trusted evidence dir missing/unsafe: {d}')
            key=(rid,project)
            if key not in success: success[key]=successful_run(d,rid,project)
            if not success[key]: continue
            if key not in snaps: snaps[key]=before_snapshot(d,project)
            old=snaps[key].get(ref)
            if old is None or old==current or old not in images: continue
            images[old]['repositories']=sorted(set(images[old]['repositories'])|{lineage}); chosen=old; break
        if chosen:
            out.append({'project':project,'service':name,'source':'v28-compose-evidence','phase':'pre-mutation','outcome':'success','image_id':chosen})
    return sorted(out,key=lambda x:(x['project'],x['service'],x['image_id']))

def collect_volumes(r:Runner):
    names=[x for x in r.run(['docker','volume','ls','-q']).split() if x]
    if not names: return []
    rows=parse_array(r.run(['docker','volume','inspect',*names]),'docker volume inspect'); out=[]
    for row in rows:
        if not isinstance(row,dict): raise ReportError('volume inspect entry must be object')
        name=row.get('Name'); labels=row.get('Labels') or {}
        if not isinstance(name,str) or not name or not isinstance(labels,dict): raise ReportError('invalid volume entry')
        project=labels.get('com.docker.compose.project')
        if project is not None and (not isinstance(project,str) or not project): raise ReportError(f'invalid volume project: {name}')
        kind='anonymous' if HEX64_RE.fullmatch(name) and not labels.get('com.docker.compose.volume') else 'named'
        out.append({'name':name,'project':project,'kind':kind})
    return sorted(out,key=lambda x:x['name'])

def collect_cache(r:Runner,max_bytes:int):
    rows=[]
    for line in r.run(['docker','system','df','--format','{{json .}}']).splitlines():
        if line.strip():
            v=parse_json(line,'docker system df')
            if not isinstance(v,dict): raise ReportError('system df row must be object')
            rows.append(v)
    matches=[x for x in rows if x.get('Type')=='Build Cache']
    if len(matches)!=1: raise ReportError(f'expected one Build Cache row, got {len(matches)}')
    size,reclaim=matches[0].get('Size'),matches[0].get('Reclaimable')
    if not isinstance(size,str) or not isinstance(reclaim,str): raise ReportError('Build Cache values must be strings')
    return {'bytes':parse_bytes(size),'reclaimable_bytes':parse_bytes(reclaim),'max_bytes':max_bytes}

def root_used(r:Runner)->int:
    lines=[x for x in r.run(['df','-P','/']).splitlines() if x.strip()]
    if len(lines)<2: raise ReportError('df output missing data')
    fields=lines[-1].split()
    if len(fields)<5 or not fields[4].endswith('%'): raise ReportError('cannot parse df')
    try: n=int(fields[4][:-1])
    except ValueError as exc: raise ReportError('cannot parse df') from exc
    if not 0<=n<=100: raise ReportError('df percent out of range')
    return n

def collect_raw(r:Runner,projects,root,run_ids,now,retention,reserve,high,cache_max):
    containers,by_id=collect_containers(r); images=collect_images(r)
    if not images: raise ReportError('local image inventory empty')
    for c in containers:
        if c['image_id'] not in images: raise ReportError(f"container image absent from image inventory: {c['name']}")
    managed,refs=collect_services(r,projects,by_id,images); by_name={x['name']:x['image_id'] for x in containers}
    rollback=collect_rollback(root,run_ids,managed,refs,images,by_name)
    return {'schema':'rpi5-docker-runtime-inventory.v1','policy':{'now_epoch':now,'retention_seconds':retention,'superseded_keep_per_lineage':reserve,'root_used_percent':root_used(r),'disk_high_watermark_percent':high},'images':sorted(images.values(),key=lambda x:x['id']),'containers':containers,'managed_services':managed,'rollback_evidence':rollback,'volumes':collect_volumes(r),'build_cache':collect_cache(r,cache_max)}

def parse_project(v:str):
    if '=' not in v: raise argparse.ArgumentTypeError('must be NAME=/absolute/path')
    name,raw=v.split('=',1)
    if not PROJECT_RE.fullmatch(name): raise argparse.ArgumentTypeError('invalid project name')
    p=Path(raw)
    if not p.is_absolute(): raise argparse.ArgumentTypeError('project path must be absolute')
    return name,p

def pos(v:str):
    try:n=int(v)
    except ValueError as exc: raise argparse.ArgumentTypeError('must be integer') from exc
    if n<=0: raise argparse.ArgumentTypeError('must be > 0')
    return n

def nonneg(v:str):
    try:n=int(v)
    except ValueError as exc: raise argparse.ArgumentTypeError('must be integer') from exc
    if n<0: raise argparse.ArgumentTypeError('must be >= 0')
    return n

def main()->int:
    ap=argparse.ArgumentParser(description='Read-only Docker retention collector/report; no Docker mutations.')
    ap.add_argument('--project',action='append',type=parse_project,required=True,metavar='NAME=/PATH')
    ap.add_argument('--evidence-root',type=Path,default=Path('/var/log/rpi5-maintenance'))
    ap.add_argument('--trusted-evidence-run',action='append',default=[])
    ap.add_argument('--retention-seconds',type=nonneg,required=True)
    ap.add_argument('--superseded-keep-per-lineage',type=nonneg,required=True)
    ap.add_argument('--disk-high-watermark-percent',type=pos,required=True)
    ap.add_argument('--build-cache-max-bytes',type=nonneg,required=True)
    ap.add_argument('--command-timeout-seconds',type=pos,default=15)
    ap.add_argument('--now-epoch',type=pos)
    ap.add_argument('--raw-inventory',action='store_true')
    ap.add_argument('--pretty',action='store_true')
    a=ap.parse_args()
    if a.disk_high_watermark_percent>100: ap.error('--disk-high-watermark-percent must be <= 100')
    if not a.trusted_evidence_run: ap.error('at least one --trusted-evidence-run is required')
    names=[x[0] for x in a.project]
    if len(names)!=len(set(names)): ap.error('duplicate --project name')
    if set(names)!={'main','cv'} or len(names)!=2: ap.error('exactly --project main=/... and --project cv=/... are required')
    now=a.now_epoch or int(dt.datetime.now(tz=dt.timezone.utc).timestamp())
    try:
        raw=collect_raw(Runner(a.command_timeout_seconds),a.project,a.evidence_root,a.trusted_evidence_run,now,a.retention_seconds,a.superseded_keep_per_lineage,a.disk_high_watermark_percent,a.build_cache_max_bytes)
        if a.raw_inventory: result=raw
        else:
            root=Path(__file__).resolve().parents[1]
            inv=load_module('rpi5_retention_inventory',root/'lib'/'rpi5-docker-retention-inventory.py')
            plan=load_module('rpi5_retention_plan',root/'lib'/'rpi5-docker-retention-plan.py')
            result=plan.build_plan(inv.build_inventory(raw))
    except (OSError,ValueError,ReportError) as exc:
        print(f'retention-report error: {exc}',file=sys.stderr); return 2
    json.dump(result,sys.stdout,sort_keys=True,indent=2 if a.pretty else None); sys.stdout.write('\n'); return 0

if __name__=='__main__': raise SystemExit(main())
